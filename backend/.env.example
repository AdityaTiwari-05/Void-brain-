# Abhedya-Chakra backend configuration
# Copy this to .env and adjust as needed

# DuckDB
DB_PATH=data/processed/abhedya.duckdb
ANALYTICS_DB_PATH=data/processed/abhedya.duckdb
DUCKDB_MEMORY_LIMIT=10GB
DUCKDB_THREADS=4

# API limits
QUERY_MAX_LIMIT=1000
QUERY_DEFAULT_LIMIT=100

# Logging
LOG_LEVEL=INFO

# Schema
SCHEMA_VERSION=1
